{
  "name": "Memory",
  "short_name": "Memory",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0e0e12",
  "theme_color": "#0e0e12",
  "icons": [
    { "src": "/icon.svg", "type": "image/svg+xml", "sizes": "any", "purpose": "any" }
  ],

  "_comment_share_target": "Android share-target intake for smart capture. The OS POSTs shared text/links/images here; the app routes them into the capture flow. TODO: handle the /share route (and accept images once vision capture exists).",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
